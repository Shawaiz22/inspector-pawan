# Server-only. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional. Without it the app stores workspaces and briefs in the browser.
DATABASE_URL=
# Access code for gating application workspace. Defaults to PAWAN2026 if unset.
APP_ACCESS_CODE=

# Email Delivery (Option 1: Gmail / Standard SMTP - Send to any recipient without a custom domain)
SMTP_USER=
SMTP_PASS=
# Optional SMTP overrides (defaults to Gmail SSL: smtp.gmail.com:465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM=

# Email Delivery (Option 2: Resend API - Requires verified domain to send to external recipients)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Local development helper (shows access code preview in UI when email credentials are not set). Set to false to hide.
DEV_ACCESS_CODE_PREVIEW=true
